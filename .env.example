# Required for the NAT/Cloudflare path.
CF_TUNNEL_TOKEN=eyJ...
CF_DOMAIN=proxy.example.com

# Cloudflare transport: auto, quic, or http2.
CF_PROTOCOL=auto

# XHTTP mode: auto, packet-up, stream-up, or stream-one.
# auto is recommended with Cloudflare Tunnel.
XHTTP_MODE=auto

# Egress from Xray: direct, socks, or http.
# USER/PASS are optional. Leave both empty for an anonymous SOCKS5/HTTP proxy.
# In Docker, 127.0.0.1 / localhost / 0.0.0.0 / ::1 are automatically mapped
# to the Docker host gateway so a proxy running on the NAT host is reachable.
OUTBOUND_TYPE=direct
OUTBOUND_HOST=
OUTBOUND_PORT=
OUTBOUND_USER=
OUTBOUND_PASS=

# Only affects HTTP egress because Xray's HTTP outbound is TCP-only.
# block prevents UDP from bypassing the HTTP proxy; direct sends UDP from the server directly.
HTTP_UDP_POLICY=block

# VLESS Encryption authentication: x25519 or mlkem768.
VLESSENC_AUTH=x25519

# Optional advanced overrides. Normally leave these unset so the container
# generates and persists identity in the /etc/vhec volume.
# UUID=
# XHTTP_PATH=
# PORT=8080
# LISTEN=127.0.0.1
